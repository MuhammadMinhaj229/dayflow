# Required for persistent production storage
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/dayflow?retryWrites=true&w=majority
MONGODB_DB=dayflow

# Single-owner authentication for the first release
DAYFLOW_ADMIN_EMAIL=you@example.com
DAYFLOW_ADMIN_PASSWORD_HASH=<bcrypt-hash-from-npm-run-password-hash>
DAYFLOW_AUTH_SECRET=<at-least-32-random-characters>
DAYFLOW_SESSION_COOKIE=dayflow_session
DAYFLOW_SESSION_TTL_SECONDS=604800

# External plan-import endpoint. Keep this secret server-side only.
DAYFLOW_SYNC_TOKEN=<long-random-secret>

# Preview only: enables local demo mode without persistent data.
DAYFLOW_DEMO_MODE=false
